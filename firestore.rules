rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny: Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Minimal Public Payment Status:
    // The checkout page is permitted ONLY to get / listen (onSnapshot) to a single document
    // using its cryptographically unguessable statusToken ID.
    // List/querying is strictly denied to prevent token enumeration.
    // All client mutations (create, update, delete) are strictly forbidden.
    match /public_payment_statuses/{statusToken} {
      allow get: if statusToken is string && statusToken.size() >= 16 && statusToken.size() <= 128;
      allow list: if false;
      allow write: if false;
    }

    // 3. Financial & Sensitive Collections:
    // Strictly DENY ALL client reads and writes.
    // Accessed ONLY server-side via Firebase Admin SDK in Vercel serverless API routes.
    match /merchants/{merchantId} {
      allow read, write: if false;
    }

    match /payments/{paymentId} {
      allow read, write: if false;
    }

    match /processed_transactions/{idempotencyKey} {
      allow read, write: if false;
    }

    match /devices/{deviceId} {
      allow read, write: if false;
    }

    match /wallets/{walletId} {
      allow read, write: if false;
    }

    match /api_keys/{keyId} {
      allow read, write: if false;
    }

    match /sms_logs/{smsId} {
      allow read, write: if false;
    }

    match /webhook_logs/{logId} {
      allow read, write: if false;
    }

    match /audit_logs/{auditId} {
      allow read, write: if false;
    }
  }
}
