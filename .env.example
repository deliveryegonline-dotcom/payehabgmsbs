# ==============================================================================
# EHABGM Pay Gateway - Environment Variables
# ==============================================================================

# --- Firebase Admin SDK Credentials (Server-side inside Vercel API Routes) ---
# You can provide the credentials in either of two formats:
# Format A: Individual environment variables:
FIREBASE_PROJECT_ID="ai-studio-applet-webapp-bbcb5"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@ai-studio-applet-webapp-bbcb5.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIRESTORE_DATABASE_ID="ai-studio-ehabgmpay-693a03fc-e66d-424c-84f3-310cec17dcd1"

# Format B: Full JSON service account key string (Alternative to Format A):
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# --- Optional Client-side Public Firebase Config (for Hosted Checkout onSnapshot) ---
# Auto-read from firebase-applet-config.json if present, or override via VITE_ variables:
VITE_FIREBASE_API_KEY="AIzaSyDXUdyymvHuf_Rdh6wEp2fJ-kDw63jtBxU"
VITE_FIREBASE_PROJECT_ID="ai-studio-applet-webapp-bbcb5"
VITE_FIREBASE_DATABASE_ID="ai-studio-ehabgmpay-693a03fc-e66d-424c-84f3-310cec17dcd1"

# --- Vercel Cron Security Secret ---
# Protects /api/cron/expire-payments from unauthorized execution
CRON_SECRET="your_random_secure_cron_secret_key_here"

# --- Application Base URL ---
APP_URL="https://pay.ehabgm.sbs"

# --- Server Port (default 3000) ---
PORT=3000

# --- Node Environment ---
NODE_ENV="production"
